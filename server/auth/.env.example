# ============================================================
#  Anh Hung Xung Ba - Auth Service
#  Copy file nay thanh .env roi dien gia tri that.
#  TUYET DOI KHONG commit file .env len git.
# ============================================================

NODE_ENV=development
PORT=8080

# URL cong khai cua chinh service nay.
# Google se redirect nguoi choi ve <PUBLIC_BASE_URL>/auth/google/callback
# Dev:  http://localhost:8080
# Prod: https://api.tenmiencuaban.com   (BAT BUOC phai la https)
PUBLIC_BASE_URL=http://localhost:8080

# ------------------------------------------------------------
# PostgreSQL
# ------------------------------------------------------------
DATABASE_URL=postgres://postgres:matkhau@localhost:5432/anhhung
# Bat SSL khi dung DB cloud (Supabase, Neon, RDS...). Dev de false.
DATABASE_SSL=false

# ------------------------------------------------------------
# GOOGLE OAUTH  <-- 2 GIA TRI NAY BAN LAY TU GOOGLE CLOUD CONSOLE
# Xem huong dan tung buoc o README.md muc "Lay key Google"
# Loai OAuth client can tao: "Web application"
# ------------------------------------------------------------
GOOGLE_CLIENT_ID=dien-vao-day.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-dien-vao-day

# ------------------------------------------------------------
# JWT
# Sinh chuoi ngau nhien 64 ky tu bang lenh:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Doi secret nay = dang xuat toan bo nguoi choi. Khong doi bua bai.
# ------------------------------------------------------------
JWT_SECRET=thay-bang-chuoi-ngau-nhien-that-dai-it-nhat-32-ky-tu
JWT_ISSUER=anhhung-auth
JWT_AUDIENCE=anhhung-game

# Thoi han token (giay)
ACCESS_TOKEN_TTL_SEC=900          # 15 phut
REFRESH_TOKEN_TTL_SEC=5184000     # 60 ngay
LOGIN_SESSION_TTL_SEC=300         # 5 phut - thoi gian toi da de bam xong Google

# ------------------------------------------------------------
# Khac
# ------------------------------------------------------------
# Bat khi chay sau reverse proxy (nginx, Cloudflare, Railway, Render).
# Neu bat sai, rate limit se tinh nham IP -> chan oan nguoi choi.
TRUST_PROXY=false

# Ten game hien tren trang callback trong trinh duyet
APP_DISPLAY_NAME=Anh Hung Xung Ba
